# ==============================================================================
# o11y.works Environment Variables Template (.env.example)
# DO NOT COMMIT RAW SECRETS OR TOKENS TO GIT REPOSITORIES
# ==============================================================================

# Keystatic GitHub OAuth Application Credentials
# Create OAuth App at: https://github.com/settings/applications/new
# Authorization Callback URL: https://o11y.works/api/keystatic/github/created-app
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Public Base URL
VITE_SITE_URL=https://o11y.works
